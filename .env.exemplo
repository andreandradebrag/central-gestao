# Copie para .env e preencha. NUNCA envie este arquivo para o GitHub.
FISCAL_TOKEN=troque-por-um-segredo-longo-e-aleatorio
CNPJ=00000000000000
UF=SP
AMBIENTE=2
CERT_SENHA=
INTERVALO_MIN=60
AUTO_CIENCIA=1
NFSE_ADN=1
# opcional: liga a IA do sistema (leitura de PDFs, sugestões, planos de ação)
ANTHROPIC_API_KEY=
# ponto Sólides DP: token de integração pedido ao suporte da Sólides (Empregador › Integrações). Deixe vazio até receber.
SOLIDES_TOKEN=
SOLIDES_INTERVALO_MIN=15
SOLIDES_DIAS_INICIAIS=35
# extrato automático: Banco do Brasil (API oficial). Credenciais do portal BB Developers (produção).
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_APP_KEY=
# certificado A1 da empresa para a conexão com o BB: uma cópia do .pfx em /opt/central/certs/bb.pfx (veja o LEIA-ME)
BB_CERT_PATH=/certs/bb.pfx
BB_CERT_SENHA=
# opcional, desligado: Itaú e Caixa pelo Open Finance (Pluggy). Deixe vazio.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
BANCOS_INTERVALO_MIN=180
