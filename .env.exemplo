# Copie para .env e preencha. NUNCA envie este arquivo para o GitHub.
# Segredos: gere cada um com  openssl rand -hex 32  (o instalar.sh gera sozinho e guarda em /opt/central/segredos.env)
FISCAL_TOKEN=troque-por-um-segredo-longo-e-aleatorio
# código de instalação: sem ele ninguém cria a conta do dono em /setup (abra https://seu-dominio/setup?token=...)
SETUP_TOKEN=
# chave mestra: cifra no banco o segredo da verificação em duas etapas. NÃO TROQUE depois de usar (veja o LEIA-ME).
CHAVE_MESTRA=
# chave das cópias de segurança (AES-256-GCM). Guarde também FORA do servidor: sem ela as cópias não abrem.
BACKUP_CHAVE=
CNPJ=00000000000000
UF=SP
AMBIENTE=2
CERT_SENHA=
INTERVALO_MIN=60
AUTO_CIENCIA=1
NFSE_ADN=1
# opcional: liga a IA do sistema (leitura de PDFs, sugestões, planos de ação)
ANTHROPIC_API_KEY=
# ponto Sólides DP: token de integração pedido ao suporte da Sólides (Empregador › Integrações). Deixe vazio até receber.
SOLIDES_TOKEN=
SOLIDES_INTERVALO_MIN=15
SOLIDES_DIAS_INICIAIS=35
# extrato automático: Banco do Brasil (API oficial). Credenciais do portal BB Developers (produção).
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_APP_KEY=
# certificado A1 da empresa para a conexão com o BB: uma cópia do .pfx em /opt/central/certs/bb.pfx (veja o LEIA-ME)
BB_CERT_PATH=/certs/bb.pfx
BB_CERT_SENHA=
# opcional, desligado: Itaú e Caixa pelo Open Finance (Pluggy). Deixe vazio.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
BANCOS_INTERVALO_MIN=180

# Endereço do sistema (usado nos links enviados por e-mail)
APP_URL=https://app.inaservicos.com.br
# E-mail do sistema (convite de novo usuário e "Esqueci minha senha")
# 465 = SSL; 587 = STARTTLS. Ex.: Hostinger smtp.hostinger.com, Google smtp.gmail.com, Microsoft smtp.office365.com (587)
SMTP_HOST=
SMTP_PORT=465
SMTP_USUARIO=inaservicos@inaservicos.com.br
SMTP_SENHA=
SMTP_REMETENTE=INA Serviços <inaservicos@inaservicos.com.br>

# Permissão de gravação por módulo: avisar (só registra, padrão) ou bloquear
PERFIL_GRAVACAO=avisar

# Verificação em duas etapas obrigatória: equipe (dono + perfis de Equipe que gravam; padrão), dono, ou nao
DOIS_FATORES_OBRIGATORIO=equipe
# dias de prazo para cada pessoa ligar, contados do primeiro acesso depois da mudança (0 = na hora)
DOIS_FATORES_CARENCIA_DIAS=0
# senha mínima do dono e da Equipe que grava (colaboradores: 8)
SENHA_MINIMA_EQUIPE=12
# sessão: horas sem uso até sair (Equipe) e dias (Colaborador); minutos que vale a confirmação de senha
SESSAO_INATIVIDADE_HORAS=10
SESSAO_COLABORADOR_DIAS=30
REAUTENTICAR_MINUTOS=15
# cota de anexos por pessoa, em MB (0 = sem limite); alerta de disco abaixo deste % livre
ANEXOS_COTA_MB=2048
ANEXOS_COTA_COLABORADOR_MB=300
DISCO_ALERTA_PCT=10

# Cópia de segurança diária (03:00) em /data/backups, guardando BACKUP_DIAS dias
BACKUP_DIAS=30
# Opcional: cópia também fora do servidor (S3, Cloudflare R2, Backblaze B2, Wasabi)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGIAO=auto
BACKUP_S3_CHAVE=
BACKUP_S3_SEGREDO=
BACKUP_S3_PASTA=central
# anexos na cópia: 1 (padrão) ou 0; cópia completa a cada N dias; tamanho máximo de cada pacote
BACKUP_ANEXOS=1
BACKUP_ANEXOS_COMPLETO_DIAS=7
BACKUP_ANEXOS_VOLUME_MB=1024
