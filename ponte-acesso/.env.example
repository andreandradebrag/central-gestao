# Ponte de acesso — copie para .env (no mesmo diretório do ponte.js) e preencha.
# Endereço do sistema (sempre https://). A ponte só faz conexões de SAÍDA: nenhuma porta precisa ser aberta no roteador.
SERVIDOR_URL=https://app.inaservicos.com.br
# Token desta ponte: Controle de acesso › Pontes, dispositivos e pontes › Nova ponte (ou "Novo token"). Aparece uma vez só.
PONTE_TOKEN=pa_cole_aqui_o_token_mostrado_no_sistema
# Arquivo com o endereço e a senha de cada controlador CT 3000 desta rede (copie controladores.example.json)
CONTROLADORES_ARQ=./controladores.json
# Pasta da fila de eventos e do estado (não apague: é o que guarda os eventos enquanto a internet está fora)
DADOS_DIR=./dados
# Espera longa no servidor (segundos) e intervalo de leitura dos eventos dos controladores (segundos)
ESPERA_S=25
EVENTOS_S=3
